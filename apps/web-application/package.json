{
  "name": "stage-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --dir ../../packages/data-ops run build",
    "dev": "vite",
    "prebuild": "pnpm --dir ../../packages/data-ops run build",
    "build": "tsc -b && vite build && node scripts/prerender-marketing.mjs",
    "prebuild:stage": "pnpm --dir ../../packages/data-ops run build",
    "build:stage": "tsc -b && vite build --mode production && node scripts/prerender-marketing.mjs",
    "prebuild:testing": "pnpm --dir ../../packages/data-ops run build",
    "build:testing": "tsc -b && vite build --mode testing && node scripts/prerender-marketing.mjs",
    "prebuild:production": "pnpm --dir ../../packages/data-ops run build",
    "build:production": "tsc -b && vite build --mode production && node scripts/prerender-marketing.mjs",
    "preview": "vite preview",
    "pretypecheck": "pnpm --dir ../../packages/data-ops run build",
    "typecheck": "tsc --noEmit",
    "testing:deploy": "pnpm run build:testing && npx wrangler deploy -e testing",
    "testing:upload": "pnpm run build:testing && npx wrangler versions upload -e testing",
    "stage:deploy": "pnpm run build:stage && npx wrangler deploy -e stage",
    "stage:upload": "pnpm run build:stage && npx wrangler versions upload -e stage",
    "ship": "node scripts/ship.mjs production",
    "ship:testing": "node scripts/ship.mjs testing",
    "production:deploy": "pnpm run build:production && npx wrangler deploy -e production",
    "production:upload": "pnpm run build:production && npx wrangler versions upload -e production",
    "cf:typegen": "npx wrangler types --env-interface CloudflareEnv worker-env.d.ts",
    "stitch:check": "node ./scripts/stitch/check.mjs",
    "smoke:rest": "node ./scripts/smoke/rest.mjs",
    "smoke:stitch": "node ./scripts/smoke/stitch.mjs",
    "smoke:top3": "pnpm run smoke:rest && pnpm run smoke:stitch",
    "check:seo": "node scripts/check-seo.mjs",
    "check:page-shell": "node scripts/check-page-shell.mjs",
    "test:telemetry": "node --import tsx --test worker/telemetry/telemetry.test.ts",
    "telemetry:deploy:testing": "pnpm run test:telemetry && pnpm run typecheck && wrangler deploy --config wrangler.telemetry.jsonc -e testing"
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@convex-dev/auth": "^0.0.91",
    "@convex-dev/r2": "0.9.1",
    "@convex-dev/rate-limiter": "0.3.2",
    "@convex-dev/stripe": "0.1.3",
    "@google/stitch-sdk": "^0.0.3",
    "@gsap/react": "^2.1.2",
    "@hono/zod-validator": "^0.7.6",
    "@oslojs/crypto": "^1.0.1",
    "@phosphor-icons/react": "^2.1.7",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@stage/data-ops": "workspace:*",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.112.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "convex": "^1.32.0",
    "convex-helpers": "0.1.114",
    "gsap": "^3.14.2",
    "hono": "4.12.9",
    "jose": "5.10.0",
    "motion": "^12.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^2.0.5",
    "resend": "^6.10.0",
    "stripe": "^20.4.0",
    "tailwind-merge": "^3.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260526.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-plugin": "^1.112.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.27.3",
    "miniflare": "4.20260526.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.69.0"
  }
}
