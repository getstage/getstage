# Production web build (getstage.co) -> production Convex deployment.
# Without this file, `vite build --mode production` falls back to .env.local
# (which targets the testing deployment), so getstage.co would mint tokens from
# the wrong Convex and production sign-in fails with
# "No auth provider found matching the given token".
CONVEX_URL=https://quirky-snail-763.convex.cloud
CONVEX_SITE_URL=https://quirky-snail-763.convex.site
VITE_CONVEX_URL=https://quirky-snail-763.convex.cloud
VITE_CONVEX_SITE_URL=https://quirky-snail-763.convex.site
