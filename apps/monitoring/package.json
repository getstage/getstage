{
  "name": "@stage/monitoring",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4310 --strictPort",
    "build": "pnpm run test && pnpm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4310 --strictPort",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "deploy:testing": "pnpm run build && pnpm --filter stage-app exec wrangler deploy --config ../monitoring/wrangler.jsonc -e testing"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "tsx": "^4.20.0",
    "vite": "^6.1.0",
    "yaml": "^2.8.0"
  }
}
