{
  "name": "stage-user-application",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "pnpm --dir ../../packages/data-ops run build && cargo build --manifest-path ../stage-engine/Cargo.toml",
    "dev": "env -u ELECTRON_RUN_AS_NODE RUST_LOG=stage_engine=debug,tower_http=info electron-vite dev",
    "prebuild": "pnpm --dir ../../packages/data-ops run build",
    "build": "tsc --noEmit && electron-vite build",
    "pretypecheck": "pnpm --dir ../../packages/data-ops run build",
    "typecheck": "tsc --noEmit",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview"
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@convex-dev/auth": "^0.0.91",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@stage/data-ops": "workspace:*",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.112.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "convex": "1.32.0",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.5.0",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
