{
  "name": "stage-user-application",
  "private": true,
  "version": "0.1.53",
  "type": "commonjs",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "pnpm --dir ../../packages/data-ops run build && cargo build --manifest-path ../stage-engine/Cargo.toml",
    "dev": "env -u ELECTRON_RUN_AS_NODE RUST_LOG=stage_engine=debug,tower_http=info electron-vite dev",
    "prebuild": "pnpm --dir ../../packages/data-ops run build",
    "build": "tsc --noEmit && electron-vite build",
    "build:engine": "cargo build --release --manifest-path ../stage-engine/Cargo.toml && node ./scripts/copy-stage-engine.mjs",
    "build:engine:arm64": "cargo build --release --manifest-path ../stage-engine/Cargo.toml --target aarch64-apple-darwin && CARGO_BUILD_TARGET=aarch64-apple-darwin node ./scripts/copy-stage-engine.mjs",
    "build:engine:x64": "cargo build --release --manifest-path ../stage-engine/Cargo.toml --target x86_64-apple-darwin && CARGO_BUILD_TARGET=x86_64-apple-darwin node ./scripts/copy-stage-engine.mjs",
    "write-runtime-secrets": "node ./scripts/write-runtime-secrets.mjs",
    "dist:mac": "pnpm run build && pnpm run build:engine && pnpm run write-runtime-secrets && electron-builder --mac --config electron-builder.yml",
    "dist:mac:arm64": "pnpm run build && pnpm run build:engine:arm64 && pnpm run write-runtime-secrets && electron-builder --mac dmg --arm64 --config electron-builder.yml",
    "dist:mac:x64": "pnpm run build && pnpm run build:engine:x64 && pnpm run write-runtime-secrets && electron-builder --mac dmg --x64 --config electron-builder.yml",
    "pretypecheck": "pnpm --dir ../../packages/data-ops run build",
    "typecheck": "tsc --noEmit",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview"
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@convex-dev/auth": "^0.0.91",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@stage/data-ops": "workspace:*",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.112.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "convex": "1.32.0",
    "dotenv": "^17.4.2",
    "emoji-picker-react": "^4.19.1",
    "gsap": "^3.15.0",
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "electron-updater": "^6.6.2",
    "tailwind-merge": "^3.5.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.5.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
