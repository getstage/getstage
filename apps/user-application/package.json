{
  "name": "stage-user-application",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "pnpm --dir ../../packages/data-ops run build",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "prebuild": "pnpm --dir ../../packages/data-ops run build",
    "build": "tsc --noEmit && electron-vite build",
    "pretypecheck": "pnpm --dir ../../packages/data-ops run build",
    "typecheck": "tsc --noEmit",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview"
  },
  "dependencies": {
    "@stage/data-ops": "file:../../packages/data-ops",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.112.0",
    "clsx": "^2.1.1",
    "motion": "^12.38.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^41.5.0",
    "electron-vite": "^4.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
