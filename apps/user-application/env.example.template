# Copy to apps/user-application/.env (never commit .env or env.example)
# Local dev: use this file.
# CI / DMG releases: set GitHub secrets REFERO_MCP_TOKEN + OPENROUTER_API_KEY
# (written to resources/runtime-secrets.env at build time; Convex REFERO_MCP_TOKEN is optional fallback)
REFERO_MCP_TOKEN=mcp-your-refero-token-here
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
VITE_CONVEX_URL=https://your-deployment.convex.cloud
