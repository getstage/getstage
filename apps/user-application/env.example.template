# Copy to apps/user-application/.env (never commit .env or env.example)
# Local dev: use this file.
# CI / DMG releases: set GitHub secrets REFERO_MCP_TOKEN + OPENROUTER_API_KEY + R2_PUBLIC_BASE_URL
# (written to resources/runtime-secrets.env at build time; Convex REFERO_MCP_TOKEN is optional fallback)
# R2_PUBLIC_BASE_URL is the public R2 custom domain (e.g. https://assets.getstage.co) — not secret,
# but baked in via the same path so packaged builds can resolve Hi-Fi Figma preview URLs.
REFERO_MCP_TOKEN=mcp-your-refero-token-here
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
VITE_CONVEX_URL=https://your-deployment.convex.cloud
R2_PUBLIC_BASE_URL=https://assets.getstage.co
