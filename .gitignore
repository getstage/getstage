# macOS
.DS_Store

# Node
node_modules/
**/node_modules/

# pnpm store must never live inside the repo (misconfigured store-dir)
.pnpm-store/

# Build outputs
dist/
**/dist/
apps/user-application/out/
apps/user-application/release/
apps/user-application/resources/stage-engine/stage-engine
apps/user-application/resources/wireframe-renderer/
**/target/
.tanstack/
*.tsbuildinfo

# Accidental Vite/output at repo root (apps live under apps/, not ./app/)
/app/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env / secrets — never commit real keys or signing credentials
.env
.env.*
# ...but the web app's per-mode Convex URLs are public config (not secrets) —
# commit them so production builds never fall back to a developer's .env.local.
!apps/web-application/.env.production
!apps/web-application/.env.testing
apps/user-application/resources/runtime-secrets.env
**/env.example

# Wrangler / Cloudflare local files
.wrangler/

# Local Claude tooling
.claude/settings.local.json
.claude/worktrees/
.claude/skills/

# Generated local skill symlinks. The source skill files live in .agents/skills/.
/skills/

# Local sibling repo used outside the app deploy
agent-mode/

# MCP server configs are local-only; each contributor opts in via the README.
.mcp.json
**/.mcp.json
.cursor/mcp.json

# Wireframe renderer scratch batches
packages/wireframe-renderer/.stage-batches/

# Local research/download scratch (source artifacts live in R2 + Convex)
.firecrawl/
apps/reactBits.webp

# Generated Figma exporter packages
apps/figma-exporter/stage-exporter-*/
apps/figma-exporter/stage-exporter-*.zip
