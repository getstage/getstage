  "sections": [
    {
      "id": "magic-ui",
      "name": "Magic UI",
      "source": "https://magicui.design",
      "exports": [
        "BentoCard",
        "BentoGrid",
        "Marquee"
      ],
      "usage": "BentoGrid takes children. BentoCard requires name and description; className, background, Icon (a component reference, e.g. an imported lucide-react icon), href and cta are optional. Marquee takes children and repeats them."
    },
    {
      "id": "aceternity-ui",
      "name": "Aceternity UI",
      "source": "https://ui.aceternity.com",
      "exports": [
        "BentoGrid",
        "BentoGridItem"
      ],
      "usage": "BentoGrid takes children. BentoGridItem takes title, description, and optional header (a ReactNode) and icon (a ReactNode, not a component reference)."
    }
  ],
  "charts": [
    {
      "id": "bklit-ui",
      "name": "Bklit UI",
      "source": "https://bklit.com",
      "exports": [
        "AreaChart",
        "BarChart",
        "ChartLegend",
        "DonutChart",
        "LineChart",
        "Sparkline"
      ],
      "usage": "Every chart takes data: { label: string; value: number }[] and a label string for accessibility. DonutChart also takes centerLabel and derives the center total from the data. Charts inherit brand color from currentColor \u2014 set it with a text-* class on the chart or an ancestor. Give each chart a sized container (for example h-48) because they fill their parent."
    }
  ]
}