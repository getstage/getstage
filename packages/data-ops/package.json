{
  "name": "@stage/data-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "convex"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./contracts/desktop-api": {
      "types": "./dist/contracts/desktop-api/index.d.ts",
      "default": "./dist/contracts/desktop-api/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./contracts/*": {
      "types": "./dist/contracts/*.d.ts",
      "default": "./dist/contracts/*.js"
    },
    "./contracts/desktop-api/*": {
      "types": "./dist/contracts/desktop-api/*.d.ts",
      "default": "./dist/contracts/desktop-api/*.js"
    },
    "./domain/*": {
      "types": "./dist/domain/*.d.ts",
      "default": "./dist/domain/*.js"
    },
    "./shared/demo-auth": {
      "types": "./dist/shared/demoAuth.d.ts",
      "default": "./dist/shared/demoAuth.js"
    },
    "./shared/upload-rules": {
      "types": "./dist/shared/uploadRules.d.ts",
      "default": "./dist/shared/uploadRules.js"
    },
    "./shared/type-other-label": {
      "types": "./dist/shared/typeOtherLabel.d.ts",
      "default": "./dist/shared/typeOtherLabel.js"
    },
    "./convex/api": {
      "types": "./convex/_generated/api.d.ts",
      "import": "./convex/_generated/api.js",
      "default": "./convex/_generated/api.js"
    },
    "./convex/data-model": {
      "types": "./convex/_generated/dataModel.d.ts"
    }
  },
  "scripts": {
    "prebuild": "pnpm --dir ../emails run build",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:typecheck": "tsc -p convex/tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.37",
    "@auth/core": "0.37.0",
    "@convex-dev/auth": "^0.0.91",
    "@convex-dev/r2": "0.9.1",
    "@convex-dev/rate-limiter": "0.3.2",
    "@convex-dev/resend": "^0.2.5",
    "@convex-dev/stripe": "0.1.3",
    "@google/stitch-sdk": "^0.0.3",
    "@hono/zod-validator": "^0.7.6",
    "@oslojs/crypto": "^1.0.1",
    "ai": "^7.0.79",
    "convex": "^1.32.0",
    "convex-helpers": "0.1.114",
    "hono": "4.12.9",
    "langsmith": "^0.7.17",
    "resend": "^6.10.0",
    "stage-emails": "workspace:*",
    "stripe": "^20.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
