{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stage-app",
  "main": "worker/index.ts",
  "compatibility_date": "2025-02-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/stripe/*"]
  },
  "env": {
    "testing": {
      "name": "stage-app-testing",
      // Gebruik voorlopig alleen de automatische `*.workers.dev` URL.
      // Zodra het testing-domein in Cloudflare bestaat en proxied is,
      // kun je hieronder de `routes` sectie weer terugzetten.
      "workers_dev": true,
      "routes": [
         { "pattern": "testing.getstage.co", "custom_domain": true }
       ]
    },
    "stage": {
      "name": "stage-app-stage",
      // Stage deployt met production build-mode zodat hij dezelfde Convex/DB target gebruikt.
      "workers_dev": true,
      "routes": [
        { "pattern": "stage.getstage.co", "custom_domain": true }
      ]
    },
    "production": {
      "name": "stage-app-production",
      "routes": [
        { "pattern": "getstage.co", "custom_domain": true },
        { "pattern": "www.getstage.co", "custom_domain": true }
      ]
    }
  }
}
